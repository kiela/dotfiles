#!/usr/bin/env sh

# Generating completions with "source <(tool completion zsh)" on every
# shell startup is slow. Cache the generated script per tool and only
# regenerate it when the tool's binary is newer than the cache.
__completion::load() {
  local __cmd="$1"
  local __cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh-completions"
  local __cache_file="$__cache_dir/$__cmd.zsh"
  local __bin

  __bin=$(command -v "$__cmd") || return 1

  mkdir -p "$__cache_dir"

  if [[ ! -s "$__cache_file" || "$__bin" -nt "$__cache_file" ]]; then
    # Generate into a temp file and move it into place atomically, so an
    # interrupted generation can never leave a truncated cache that then gets
    # sourced (and errors) on every subsequent startup.
    local __tmp="$__cache_file.$$.tmp"
    if "$__cmd" completion zsh > "$__tmp" 2> /dev/null && [[ -s "$__tmp" ]]; then
      mv "$__tmp" "$__cache_file"
    else
      rm -f "$__tmp"
      return 1
    fi
  fi

  source "$__cache_file"
}
