#!/usr/bin/env zsh

# Source every alias file in this directory. Files prefixed with an
# underscore (like this loader) are skipped, so new alias files are
# picked up without having to list them here.

ALIAS_DIR="$HOME/.aliases"

# helpers used by the alias files below
if [ -f "$ALIAS_DIR/_completion" ]; then
  source "$ALIAS_DIR/_completion"
fi

if [ -d "$ALIAS_DIR" ]; then
  for __alias_file in "$ALIAS_DIR"/*; do
    case "$(basename "$__alias_file")" in
      _*) continue ;;
    esac

    if [ -f "$__alias_file" ]; then
      source "$__alias_file"
    fi
  done
  unset __alias_file
else
  echo "WARNING: $ALIAS_DIR not found."
fi

unset ALIAS_DIR
