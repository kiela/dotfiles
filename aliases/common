pwd() {
  # Pass the standard flags (-L/-P) straight through to the builtin.
  case "${1:-}" in
    -*)
      builtin pwd "$@"
      return
      ;;
  esac

  if [ $# -eq 0 ]; then
    builtin pwd
  elif [ ! -d "$1" ]; then
    echo "pwd: $1: Not a directory" >&2
    return 1
  elif command -v realpath > /dev/null 2>&1; then
    realpath "$1"
  else
    # stock macOS lacks realpath before 13; resolve in a subshell instead
    (cd "$1" && builtin pwd -P)
  fi
}

if (type youtube-dl &> /dev/null); then
  alias youtube-dl="youtube-dl -f best"
fi

if (type pbcopy &> /dev/null); then
  alias pbc="pbcopy"
fi


__cd::ln() {
  local __link="$1"
  local __target __dir

  if [[ $# -eq 0 ]]; then
    echo "Error: No symbolic link provided."
    echo "Usage: cdln <symbolic_link>"
    return 1
  fi

  # ${x:A} resolves the whole path to an absolute one, following symlink
  # chains relative to each link's own location - unlike `readlink`, whose
  # raw (often relative) output dirname was wrongly resolved against $PWD.
  if [[ -L "$__link" ]]; then
    __target="${__link:A}"
  elif __target=$(command -v "$__link" 2> /dev/null) && [[ -n "$__target" ]]; then
    __target="${__target:A}"
  else
    echo "Error: Neither a valid symbolic link nor a command found for '$__link'."
    return 1
  fi

  __dir="${__target:h}"

  cd "$__dir" || {
    echo "Error: Could not change directory to $__dir." >&2
    return 1
  }

  echo "Current directory changed to: $(pwd)"
}

__cd::workspace() {
  local __home="${HOME}/workspace"
  local __target="${1:-}"

  if [ -z "$__target" ]; then
    cd "$__home" || return 1
  elif [ -d "$__home/$__target" ]; then
    cd "$__home/$__target" || return 1
  elif [ -e "$__home/$__target" ]; then
    # a file was given - go to the directory that contains it
    cd "$(dirname "$__home/$__target")" || return 1
  else
    echo "wr: $__target: No such file or directory" >&2
    return 1
  fi

  echo "Current directory changed to: $(pwd)"
}

__cd::workspace::completion() {
  local __home="${HOME}/workspace"

  if [[ -d "$__home" ]]; then
    _files -/ -W "$__home" -/
  else
    return 0
  fi
}

compdef __cd::workspace::completion __cd::workspace

__find::file() {
  if [[ -z "$1" ]]; then
    __find "f"
  else
    __find "f" | grep "$1"
  fi
}

__find::dir() {
  if [[ -z "$1" ]]; then
    __find "d"
  else
    __find "d" | grep "$1"
  fi
}

__find() {
  find . -type $1
}
