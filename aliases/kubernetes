__kubectl::get_decoded_secret() {
  local _name=$1

  if ! (type jq &> /dev/null); then
    echo "ERROR: Please install jq to use this feature"
    echo "-----"
    return 1
  fi

  if [[ -z "$_name" ]]; then
    kubectl get secret
  else
    for __k __v in $(kubectl get secret $_name -o json | jq -r '.data | to_entries[] | "\(.key): \(.value)"'); do
      echo -n $__k" "
      echo $__v | base64 --decode
      echo
    done
  fi
}

__kubectl::get_resource_output_json() {
  __kubectl::get_resource_output_formatted "json" "$@"
}

__kubectl::get_resource_output_yaml() {
  __kubectl::get_resource_output_formatted "yaml" "$@"
}

__kubectl::get_resource_output_formatted() {
  local __format=${1}
  local __resource=${2}
  local __formatter="qq" # TODO test yq https://github.com/mikefarah/yq
  local -a __formatter_args=("${@:3}")

  if (type $__formatter &> /dev/null); then
    kubectl get -o "$__format" "$__resource" | $__formatter -i "$__format" -o "$__format" "${__formatter_args[@]}"
  else
    echo "NOTICE: Consider installing ${__formatter} (https://github.com/JFryy/qq) to fully use this feature"
    echo ""
    kubectl get -o "$__format" "$__resource"
  fi
}

__kubectl::get_pod_name_by_label() {
  local __var __label __value __result
  local -a __args

  if [[ $# -gt 2 ]]; then
    __var="$1"
    shift
  fi
  __label="$1"
  __value="$2"
  __args=("${@:3}")

  if [[ ! -z "$__label" ]]; then
    __result=$(kubectl get pod -l "$__label=$__value" -o jsonpath='{.items[0].metadata.name}' "${__args[@]}" | head -n 1)
  else
    # TODO: can it be done using jsonpath without jq?
    __result=$(kubectl get pods -o json "${__args[@]}" | jq -r '.items[] | select(.metadata.labels[] | tostring | contains("'$__value'")) | .metadata.name' | head -n 1)
  fi

  # TODO: add debug method for those:
  #echo "var:\t$__var"
  #echo "label:\t$__label"
  #echo "value:\t$__value"
  #echo "args:\t$__args"
  #echo "result:\t$__result"
  #echo "-----"

  setvar "$__var" "$__result"
}

__kubectl::get_pod_name_by_name() {

  local __var __value __result
  local -a __args

  if [[ $# -gt 1 ]]; then
    __var="$1"
    shift
  fi
  __value="$1"
  __args=("${@:2}")

  __result=$(kubectl get pods -o json "${__args[@]}" | jq -r --arg v "$__value" '.items[] | select(.metadata.name | test($v + ".*")) | .metadata.name' | head -n 1)

  setvar "$__var" "$__result"
}

__kubectl::delete_all_objects() {
  local _object=$1

  for _o in $(kubectl get $_object --no-headers -o custom-columns=':metadata.name'); do
    kubectl delete $_object --force --grace-period 0 $_o
  done
}

__kubectl::execute() {
  local _name=$1
  local __pod
  local -a __kubectl_args
  local __pod_args="bash"

  if [[ -z "${_name:-}" ]]; then
    echo "Please provide pod name or label"
    return 1
  else
    shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)
        shift
        __pod_args="$*"
        break
        ;;
      *)
        __kubectl_args+=("$1")
        shift
        ;;
    esac
  done

  # Trim leading and trailing spaces from the remote command string
  __pod_args="${__pod_args#"${__pod_args%%[![:space:]]*}"}"
  __pod_args="${__pod_args%"${__pod_args##*[![:space:]]}"}"

  __kubectl::get_pod_name_by_name "__pod" "$_name"
  [[ -z "$__pod" ]] && __kubectl::get_pod_name_by_label "__pod" "app" "$_name"

  kubectl exec -it "$__pod" "${__kubectl_args[@]}" -- sh -c "$__pod_args"
}

__kubectl::get_pod_logs() {
    local _label=${1:-api}
    local -a _args=("${@:2}")
    local _pod

    __kubectl::get_pod_name_by_label "_pod" "app" "$_label"

    kubectl logs "$_pod" "${_args[@]}"
  }

  __kubectl::etcdctl() {
    local _args="$@"
    local _pod

    __kubectl::get_pod_name_by_label "_pod" "component" "etcd" -n kube-system

    kubectl -n kube-system exec $_pod -it -- sh -c "\
      ETCDCTL_API=3 \
      ETCDCTL_CACERT=/etc/kubernetes/pki/etcd/ca.crt \
      ETCDCTL_CERT=/etc/kubernetes/pki/etcd/server.crt \
      ETCDCTL_KEY=/etc/kubernetes/pki/etcd/server.key \
      etcdctl $_args
    "
  }

  __kubectl::get_containers() {
    local _cmd

    _cmd="kubectl get pods -o jsonpath='{range .items[*]}{\"\n\"}{.metadata.name}{\"\t\"}{.metadata.namespace}{\"\t\"}{range .spec.containers[*]}{.name}{\"=>\"}{.image}{\",\"}{end}{end}' | sort #|column -t"

    eval $_cmd
  }
fi
