#!/usr/bin/env zsh

# TODO: check https://github.com/ohmyzsh/ohmyzsh/blob/master/plugins/kubectl/kubectl.plugin.zsh

if ! (type setvar &> /dev/null); then
  setvar() {
    local _variable_to_be_set="$1"
    local _value_to_be_set="$2"

    if [[ $# -gt 2 ]]; then
      echo "$0: too many arguments"
      return 2
    fi

    # Reject anything that is not a plain identifier, then assign without
    # re-parsing the value: the old `eval name=$value` executed values
    # containing spaces (`foo=hello world` runs `world`) or $(...)/backticks.
    # Use a regex (anchored): the glob [A-Za-z_][A-Za-z0-9_]* required two
    # char classes plus a trailing wildcard and so rejected single-char names.
    if [[ "$_variable_to_be_set" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      typeset -g -- "$_variable_to_be_set=$_value_to_be_set"
    fi
  }
fi

if (type kubectl &> /dev/null); then
  # TODO: completion for zsh or dynamic based on shell?
  if (type __completion::load &> /dev/null); then
    __completion::load kubectl
  else
    source <(kubectl completion zsh)
  fi

  KUBECONFIG_FILES=()

  # (N) is the zsh null-glob qualifier: expands to nothing (instead of the
  # default NOMATCH error that aborts sourcing) when ~/.kube is empty or absent.
  for file in "$HOME"/.kube/*(N); do
    # Skip if not a regular file or not readable
    [ -f "$file" ] && [ -r "$file" ] || continue

    if grep -q "kind: Config" "$file" 2>/dev/null; then
      KUBECONFIG_FILES+=("$file")
    fi
  done

  if [ ${#KUBECONFIG_FILES[@]} -gt 0 ]; then
    export KUBECONFIG=$(IFS=:; echo "${KUBECONFIG_FILES[*]}")
  fi

  unset KUBECONFIG_FILES

  alias k='kubectl'
  alias ka='kubectl apply'
  #alias kan='kubectl annotate'
  #alias kc='kubectl create'
  alias kcfg='kubectl config'
  alias kd='kubectl describe'
  alias kg='kubectl get'
  alias kge="kubectl get events --sort-by='.firstTimestamp'"
  alias kgj='__kubectl::get_resource_output_json'
  alias kgy='__kubectl::get_resource_output_yaml'
  alias kgs="__kubectl::get_decoded_secret"
  alias kpf='kubectl port-forward'
  #alias kr='kubectl run'
  #alias kro='kubectl rollout'
  #alias kroh='kubectl rollout history'
  #alias kroh='kubectl rollout undo'
  alias krm='kubectl delete'
  alias krmf='kubectl delete --force --grace-period 0'
  alias krmall='__kubectl::delete_all_objects'
  alias ks='kubectl scale'
  alias ke='__kubectl::execute'
  alias kl='kubectl logs'
  alias klog='__kubectl::get_pod_logs'
  alias ketcd='__kubectl::etcdctl'

  alias ck='clear && k'
  alias cka='clear && ka'
  alias ckcfg='clear && kcfg'
  alias ckd='clear && kd'
  alias ckg='clear && kg'
  alias cke='clear && ke'
  alias ckl='clear && kl'

  if (type kubectx &> /dev/null); then
    alias kctx='kubectx'
    alias 'kubectl-ctx'='kubectx'
    alias kns='kubens'
    alias 'kube-ns'='kubens'
  fi

if (type watch &> /dev/null); then
  alias wk='watch -n 1 kubectl'
  alias wkg='watch -n 1 kubectl get'
  alias wkge='watch -n 1 "kubectl get events --sort-by=\".firstTimestamp\" | tail -n 10"'
  alias wkd='watch -n 1 kubectl describe'
fi

