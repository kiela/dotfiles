#!/usr/bin/env bash

set -euo pipefail

__git_all_repos() {
  local _current_dir=$1
  local _git_cmd=$2
  local _git_args=${@:3}

  echo "Walking through $_current_dir directory..."
  echo ""

  find . -type d -name ".git" -print0 | \
  while IFS= read -r -d '' __repo; do
    __dir=$(dirname "$__repo")

    if [ -f "$__dir/.gitskip" ]; then
      echo "$(tput setaf 3)"$__dir"$(tput sgr0)"
      echo "Skipping $__dir due to .gitskip"
      echo "-----"
      echo ""
      continue
    fi

    cd "$__dir" || { echo "Failed to cd into: $__dir"; exit 1; }

    if [ $(git remote | wc -l) -gt 0 ]; then
      echo "$(tput setaf 2)"$__dir"$(tput sgr0)"
      if [ -z "$_git_args" ]
      then
        git branch | awk '{print $2}' | xargs git $_git_cmd origin
      else
        git $_git_cmd $_git_args
      fi
    else
      echo "$(tput setaf 3)"$__dir"$(tput sgr0)"
      echo "Skipping $__dir due to no remote repository"
    fi

    cd "$_current_dir"
    echo "-----"
    echo ""
  done

  echo "Completed!"
}

__git_all_repos $(pwd) $@
