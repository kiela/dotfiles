#!/usr/bin/env bash

set -euo pipefail

__git_all_repos() {
  local _current_dir=$1
  shift
  # Callers pass one shell-command string (the gitconfig all-repos aliases
  # rely on pipes/&&/$()), so eval it as-is; "$*" joins without SC2124.
  local _cmd="$*"

  echo "Walking through $_current_dir directory..."
  echo ""

  # Read the repo list on fd 3 so the walked command keeps the terminal as
  # its own stdin (a command using read/prompting for a passphrase would
  # otherwise swallow the list and corrupt the walk).
  while IFS= read -r -d '' -u 3 __repo; do
    __dir=$(dirname "$__repo")

    if [ -f "$__dir/.gitskip" ]; then
      echo "$(tput setaf 3)"$__dir"$(tput sgr0)"
      echo "Skipping $__dir due to .gitskip"
      echo "-----"
      echo ""
      continue
    fi

    cd "$__dir" || { echo "Failed to cd into: $__dir"; exit 1; }

    if [ "$(git remote | wc -l)" -gt 0 ]; then
      echo "$(tput setaf 2)"$__dir"$(tput sgr0)"

      # keep going if the command fails in one repo instead of aborting
      # the whole walk under set -e
      eval "$_cmd" || echo "$(tput setaf 1)command failed in $__dir$(tput sgr0)"
    else
      echo "$(tput setaf 3)"$__dir"$(tput sgr0)"
      echo "Skipping $__dir due to no remote repository"
    fi

    cd "$_current_dir"
    echo "-----"
    echo ""
  done 3< <(find . -type d -name ".git" -print0 | sort -z)

  echo "Completed!"
}

__git_all_repos "$(pwd)" "$@"
