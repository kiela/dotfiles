#!/usr/bin/env bash

set -euo pipefail

git-all-repos() {
  local __current_dir=$1
  local __git_cmd=$2
  local __git_args=${@:3}

  echo "Pulling in latest changes for all repositories..."

  find . -type d -name ".git" -print0 | \
  while IFS= read -r -d '' _repo; do
    _dir=$(dirname "$_repo")
    cd "$_dir" || { echo "Failed to cd into: $_dir"; exit 1; }

    if [ $(git remote | wc -l) -gt 0 ]; then
      echo ""
      echo "$(tput setaf 2)"$_dir"$(tput sgr0)"
      if [ -z "$__git_args" ]
      then
        git branch | awk '{print $2}' | xargs git $__git_cmd origin
      else
        git $__git_cmd $__git_args
      fi
    fi

    cd "$__current_dir"
  done

  echo ""
  echo "Completed!"
}

git-all-repos $(pwd) $@
