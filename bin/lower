#!/usr/bin/env bash

set -euo pipefail

# Idea taken from:
# https://stackoverflow.com/a/46726373

# Explicit arguments win; otherwise read stdin whenever it is not a
# terminal - a pipe, a redirected file (lower < notes) or a here-string.
if [[ $# -gt 0 ]]; then
  printf '%s\n' "$*" | tr '[:upper:]' '[:lower:]'
elif [[ ! -t 0 ]]; then
  tr '[:upper:]' '[:lower:]'
fi
