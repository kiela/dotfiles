#!/bin/bash

set -euo pipefail

if command -v openssl &>/dev/null; then
    openssl rand -base64 64 | tr -dc 'A-Za-z0-9' | head -c 32 | pbcopy
elif command -v md5sum &>/dev/null; then
    random_string=$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | base64)
    echo -n "$(echo -n "$random_string" | md5sum | awk '{print $1}')" | pbcopy
else
    echo 'error: openssl and md5sum are both unavailable' >&2
    exit 1
fi
