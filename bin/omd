#!/usr/bin/env zsh

if ! (type __omd::execute &> /dev/null); then
  __omd::execute() {
    local _cmd=$1
    local _verbose=${2:-${OMD_VERBOSE:-false}}

    if $_verbose; then
      echo "-----"
      echo $_cmd
      echo "-----"
    fi

    eval $_cmd
  }
fi

