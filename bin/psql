#!/usr/bin/env bash

set -euo pipefail

V=${V:-false}

__debug() {
  if $V; then
    echo "DEBUG: $*"
  fi
}

# Check if Docker Desktop is running
if ! docker info &> /dev/null; then
  echo "Docker Desktop is not running..."
  exit 1
fi

__debug "docker run -it --rm --platform=linux/amd64 postgres:17-alpine psql $*"
docker run -it --rm --platform=linux/amd64 postgres:17-alpine psql "$@"
