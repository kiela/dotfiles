#!/usr/bin/env bash

set -euo pipefail

V=${V:-false}

__debug() {
  if $V; then
    echo "DEBUG: $*"
  fi
}

# Check if Docker Desktop is running
if ! docker info &> /dev/null; then
  echo "Docker Desktop is not running..."
  exit 1
fi

# Only allocate a TTY when stdin and stdout are terminals; an unconditional
# -t breaks piped or redirected input (psql ... < dump.sql, echo | psql).
flags=(-i)
if [ -t 0 ] && [ -t 1 ]; then
  flags+=(-t)
fi

__debug "docker run ${flags[*]} --rm --platform=linux/amd64 postgres:17-alpine psql $*"
docker run "${flags[@]}" --rm --platform=linux/amd64 postgres:17-alpine psql "$@"
