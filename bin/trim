#!/usr/bin/env bash

set -euo pipefail

# Idea taken from:
# https://stackoverflow.com/a/46726373

# Strip only leading/trailing whitespace per line, preserving interior
# spacing - the old `awk '{$1=$1};1'` field-rejoin also squeezed every
# internal run of whitespace to a single space.
trim() { sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'; }

# Explicit arguments win; otherwise read stdin whenever it is not a
# terminal - a pipe, a redirected file (trim < notes) or a here-string.
if [[ $# -gt 0 ]]; then
  printf '%s\n' "$*" | trim
elif [[ ! -t 0 ]]; then
  trim
fi
