#!/usr/bin/env bash

set -euo pipefail

V=${V:-false}

__debug() {
  if $V; then
    echo "DEBUG: $*"
  fi
}

__execute() {
  __debug "$@"
  eval "$@"
}

# Check if Docker Desktop is running
if ! docker info &> /dev/null; then
  echo "Docker Desktop is not running..."
  exit 1
fi


_cmd=""
_args=()

if [[ $# -eq 0 ]]; then
  _cmd="help"
else
  _cmd=$1
  shift

  for _arg in "$@"; do
    _args+=("$_arg")
  done
fi

__execute "docker run -i -v $(pwd):/vector --workdir /vector --rm timberio/vector:0.32.1-distroless-libc $_cmd ${_args[*]}"
